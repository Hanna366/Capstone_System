{
  "name": "smart-drying-rack-server",
  "version": "1.0.0",
  "description": "Web server for Smart Drying Rack IoT system",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "build:run": "npm run build && npm start",
    "clean": "rimraf dist"
  },
  "keywords": [
    "iot",
    "esp32",
    "smart-drying-rack",
    "websocket",
    "express"
  ],
  "author": "Smart Drying Rack Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/node": "^20.4.5",
    "typescript": "^5.1.6",
    "ts-node-dev": "^2.0.0",
    "rimraf": "^5.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
